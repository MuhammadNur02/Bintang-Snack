{
  "expo": {
    "name": "frontend",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.snackinventoryfix.dl97x2",
      "infoPlist": {
        "NSCameraUsageDescription": "Ambil foto bukti barang titipan",
        "NSPhotoLibraryUsageDescription": "Simpan foto bukti barang titipan",
        "NSPhotoLibraryAddUsageDescription": "Simpan foto bukti barang titipan"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.snackinventoryfix.dl97x2",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Simpan foto bukti barang titipan",
          "cameraPermission": "Ambil foto bukti barang titipan"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Ambil foto bukti barang titipan"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}